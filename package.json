{
  "name": "dsh-workspace-tags",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: tag Workspace projects with colored labels, filter the sidebar by tag, group workspaces by tag, and manage every tag in a dedicated page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tags",
    "labels",
    "workspace",
    "sidebar",
    "filter",
    "ui",
    "typescript"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "license": "MIT",
  "author": "L.H <1180795@qq.com> (https://github.com/AlienGene)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienGene/dsh-workspace-tags.git"
  },
  "homepage": "https://github.com/AlienGene/dsh-workspace-tags#readme",
  "bugs": {
    "url": "https://github.com/AlienGene/dsh-workspace-tags/issues"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run test",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
